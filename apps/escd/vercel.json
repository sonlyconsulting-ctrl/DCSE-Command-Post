{
  "version": 2,
  "routes": [
    { "src": "/api/mvp/(.*)", "dest": "/api/mvp.py" },
    { "src": "/api/mvp", "dest": "/api/mvp.py" },
    { "src": "/escd/app", "dest": "/web/mvp.html" },
    { "src": "/scripture", "dest": "/web/scripture.html" },
