{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "[ \"$VERCEL_PROJECT_ID\" = \"prj_3t9SKxOUuW0peitSq97OHWDWCQy9\" ]",
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/mvp/(.*)", "destination": "/api/mvp?mvp_path=$1" },
    { "source": "/escd/app", "destination": "/apps/escd/web/mvp.html" },
    { "source": "/scripture", "destination": "/apps/escd/web/scripture.html" },
    { "source": "/app", "destination": "/apps/escd/web/app.html" },
    { "source": "/escd", "destination": "/apps/escd/web/login.html" },
    { "source": "/login", "destination": "/apps/escd/web/login.html" },
    { "source": "/", "destination": "/apps/escd/web/scripture.html" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/apps/escd/web/login.html" }
  ]
}
