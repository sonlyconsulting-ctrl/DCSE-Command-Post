        "ui_required"
      ]
    },
    {
      "id": "ORCH-004",
      "name": "Turn reaches defined terminal or waiting state",
      "stage": "ALL",
      "enforcement": [
        "database_live",
        "runtime_required"
      ]
    },
    {
      "id": "ORCH-005",
      "name": "Supabase durable state outranks transport",
      "stage": "ALL",
      "enforcement": [
        "database_live",
        "runtime_required"
      ]
